<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="password-page">
  <main class="password-page__main">
    {% if settings.logo != blank %}
      <img src="{{ settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" width="220">
    {% else %}
      <h1>{{ shop.name }}</h1>
    {% endif %}
    <p>{{ 'general.password_page.coming_soon' | t }}</p>
    {{ content_for_layout }}
    <p class="password-page__contact">
      {% if settings.company_phone != blank %}
        <a href="tel:{{ settings.company_phone | replace: ' ', '' }}">{{ settings.company_phone }}</a>
      {% endif %}
    </p>
  </main>
</body>
</html>
