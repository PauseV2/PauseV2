<section class="section values">
  <div class="container">
    <div class="section__heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="values__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'value' -%}
            <div class="value-card" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waar wij voor staan",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Onze waarden"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Waar wij voor staan"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Waarde",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Kwaliteit zonder compromis"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>We werken met A-merken en volgens de geldende richtlijnen, voor een installatie waar u jarenlang op kunt rekenen.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Waar wij voor staan",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Kwaliteit zonder compromis",
            "text": "<p>We werken met A-merken en volgens de geldende richtlijnen, voor een installatie waar u jarenlang op kunt rekenen.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Eerlijk en transparant",
            "text": "<p>Duidelijke afspraken, heldere communicatie en geen verrassingen achteraf.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Duurzaam denken",
            "text": "<p>We adviseren altijd de meest energiezuinige oplossing die past bij uw situatie.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Persoonlijke aandacht",
            "text": "<p>Elke klant krijgt een vast aanspreekpunt en advies dat echt aansluit bij de situatie.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
