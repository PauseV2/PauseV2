<section class="section not-found">
  <div class="container not-found__inner">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="section__text">{{ section.settings.text }}</div>
    {%- endif -%}
    <a href="{{ routes.root_url }}" class="button">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Pagina niet gevonden"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>De pagina die u zocht bestaat niet (meer). Ga terug naar de homepage of neem contact met ons op.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst",
      "default": "Naar de homepage"
    }
  ]
}
{% endschema %}
