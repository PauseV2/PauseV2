<section class="section benefits">
  <div class="container">
    <div class="section__heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'benefit' -%}
            <div class="benefit-card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="benefit-card__icon">
                  <img src="{{ block.settings.icon | image_url: width: 64 }}" alt="" width="32" height="32" loading="lazy">
                </div>
              {%- else -%}
                <div class="benefit-card__icon">
                  {%- case block.settings.icon_style -%}
                    {%- when 'shield-check' -%}{% render 'icon-shield-check' %}
                    {%- when 'message-circle' -%}{% render 'icon-message-circle' %}
                    {%- when 'leaf' -%}{% render 'icon-leaf' %}
                    {%- when 'clock' -%}{% render 'icon-clock' %}
                    {%- when 'wrench' -%}{% render 'icon-wrench' %}
                    {%- when 'map-pin' -%}{% render 'icon-map-pin' %}
                    {%- else -%}{% render 'icon-check' %}
                  {%- endcase -%}
                </div>
              {%- endif -%}
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Voordelen",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Waarom kiezen voor ons"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "De voordelen van werken met ons"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Voordeel",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Eigen icoon (optioneel)",
          "info": "Upload een eigen icoon, of laat leeg en kies hieronder een van de meegeleverde iconen."
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "Icoon",
          "options": [
            { "value": "check", "label": "Vinkje" },
            { "value": "shield-check", "label": "Schild (kwaliteit/certificering)" },
            { "value": "message-circle", "label": "Gesprek (advies)" },
            { "value": "leaf", "label": "Blad (duurzaamheid/energie)" },
            { "value": "clock", "label": "Klok (snelheid)" },
            { "value": "wrench", "label": "Sleutel (service/onderhoud)" },
            { "value": "map-pin", "label": "Locatiepin (lokaal)" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Gecertificeerde installateurs"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Al onze monteurs zijn F-gassen gecertificeerd en werken volgens de geldende normen.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Voordelen",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_style": "shield-check",
            "title": "Gecertificeerde installateurs",
            "text": "<p>Al onze monteurs zijn F-gassen gecertificeerd en werken volgens de geldende normen.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "message-circle",
            "title": "Eerlijk en persoonlijk advies",
            "text": "<p>Geen verkooppraatjes, wel een oplossing die echt bij u past.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "leaf",
            "title": "Energiezuinige systemen",
            "text": "<p>Wij adviseren over de meest efficiente en duurzame oplossing voor uw situatie.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "clock",
            "title": "Nette en snelle installatie",
            "text": "<p>Vakwerk binnen de afgesproken tijd, met respect voor uw woning of pand.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "wrench",
            "title": "Service en onderhoud",
            "text": "<p>Ook na de installatie staan we voor u klaar met onderhoud en storingsdienst.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_style": "map-pin",
            "title": "Lokale betrokkenheid",
            "text": "<p>Korte lijnen en persoonlijk contact, geen anoniem callcenter.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
