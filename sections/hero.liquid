<section class="hero" {% if section.settings.image != blank %}style="--hero-image: url('{{ section.settings.image | image_url: width: 1800 }}');"{% endif %}>
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url }}" class="button">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if settings.company_phone != blank -%}
          <a href="tel:{{ settings.company_phone | replace: ' ', '' }}" class="button button--ghost">
            {%- render 'icon-phone' -%}<span>{{ settings.company_phone }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Achtergrondafbeelding"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Airconditioning specialist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Comfortabel binnenklimaat, het hele jaar rond"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Wij adviseren, installeren en onderhouden airconditioning voor woningen en bedrijven. Vakkundig, persoonlijk en zonder verrassingen achteraf.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst",
      "default": "Vraag vrijblijvend advies aan"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Knoplink",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
