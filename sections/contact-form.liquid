<section class="section contact" id="contact">
  <div class="container contact__inner">
    <div class="contact__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="contact__details" role="list">
        {%- if settings.company_phone != blank -%}
          <li>
            <a href="tel:{{ settings.company_phone | replace: ' ', '' }}">
              {%- render 'icon-phone' -%}<span>{{ settings.company_phone }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.company_email != blank -%}
          <li>
            <a href="mailto:{{ settings.company_email }}">
              {%- render 'icon-mail' -%}<span>{{ settings.company_email }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.company_address != blank -%}
          <li>{%- render 'icon-map-pin' -%}<span>{{ settings.company_address }}</span></li>
        {%- endif -%}
        {%- if settings.company_hours != blank -%}
          <li>{%- render 'icon-clock' -%}<span>{{ settings.company_hours }}</span></li>
        {%- endif -%}
      </ul>
    </div>

    <div class="contact__form-wrapper">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" tabindex="-1" autofocus>{{ 'contact.form.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-status form-status--error" tabindex="-1" autofocus>{{ 'contact.form.error' | t }}</p>
        {%- endif -%}

        <div class="field">
          <label for="ContactFormName">{{ 'contact.form.name' | t }}</label>
          <input type="text" id="ContactFormName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" autocomplete="name" required>
        </div>

        <div class="field">
          <label for="ContactFormEmail">{{ 'contact.form.email' | t }}</label>
          <input
            type="email"
            id="ContactFormEmail"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% endif %}"
            autocomplete="email"
            autocapitalize="off"
            required
          >
        </div>

        <div class="field">
          <label for="ContactFormPhone">{{ 'contact.form.phone' | t }} (optioneel)</label>
          <input type="tel" id="ContactFormPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}" autocomplete="tel">
        </div>

        <div class="field">
          <label for="ContactFormMessage">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="button">{{ 'contact.form.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contactformulier",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Stel uw vraag"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Heeft u een vraag of wilt u vrijblijvend advies? Vul het formulier in of neem direct telefonisch contact op.</p>"
    }
  ],
  "presets": [
    {
      "name": "Contactformulier"
    }
  ]
}
{% endschema %}
