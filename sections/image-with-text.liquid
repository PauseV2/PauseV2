<section class="section image-with-text {% if section.settings.layout == 'image_right' %}image-with-text--reverse{% endif %}">
  <div class="container image-with-text__inner">
    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        <div class="placeholder-image">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Afbeelding met tekst",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Indeling",
      "options": [
        { "value": "image_left", "label": "Afbeelding links" },
        { "value": "image_right", "label": "Afbeelding rechts" }
      ],
      "default": "image_left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Afbeelding"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Over ons"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Wie wij zijn"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Wij zijn een team van vakmensen met een passie voor een gezond en comfortabel binnenklimaat. Vanuit ons vak willen we ontzorgen: van eerste advies tot jarenlange nazorg.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Knoplink"
    }
  ],
  "presets": [
    {
      "name": "Afbeelding met tekst"
    }
  ]
}
{% endschema %}
