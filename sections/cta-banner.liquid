<section class="section cta-banner">
  <div class="container cta-banner__inner">
    <div class="cta-banner__text">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="cta-banner__actions">
      {%- if settings.company_phone != blank -%}
        <a href="tel:{{ settings.company_phone | replace: ' ', '' }}" class="button button--light">
          {%- render 'icon-phone' -%}<span>{{ settings.company_phone }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="button button--outline-light">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bel-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Liever direct contact?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Bel ons gerust, we denken graag vrijblijvend met u mee.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knoptekst",
      "default": "Stel uw vraag via het formulier"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Knoplink",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Bel-banner"
    }
  ]
}
{% endschema %}
