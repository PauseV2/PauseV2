  {
    "name": "Typografie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Lettertype koppen",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Lettertype tekst",
        "default": "assistant_n4"
      }
